# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=SunsetsDB

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=tu_jwt_secret_aqui

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000

# Configuración de Correo - Proveedor
# Opciones: 'resend' (recomendado para producción) o 'smtp' (Gmail)
MAIL_PROVIDER=smtp

# Resend Configuration (Mejor entregabilidad - https://resend.com)
# Para activar Resend: cambia MAIL_PROVIDER=resend y agrega tu API key
RESEND_API_KEY=

# Configuración SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_sin_espacios

# Configuración General de Correos
MAIL_FROM=Sunsets Tarbaca <tu_correo@gmail.com>
MAIL_BCC=
REPLY_TO=tu_correo@gmail.com
